{
  "ruleset_id": "internal-ai-risk",
  "version": 1,
  "required_facts": ["decision_consequence", "sensitive_data", "autonomy_level", "human_review_coverage"],
  "weights": {
    "decision_consequence": {"minimal": 0, "material": 1, "significant": 2, "severe": 4},
    "autonomy_level": {"none": 0, "assistive": 1, "bounded": 2, "autonomous": 4},
    "human_review_coverage": {"every_output": 0, "sampled": 1, "exception_only": 2, "none": 4},
    "sensitive_data": 2,
    "affected_persons": 1,
    "external_access": 1,
    "tool_access": 2
  },
  "thresholds": {"low": 2, "medium": 5, "high": 8}
}
